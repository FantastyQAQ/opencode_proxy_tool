#include <windows.h>

// 应用元信息宏（版本号 / 构建日期等）统一来自 appinfo.h，
// 保证 exe 属性里的版本信息与窗口标题、关于对话框永远一致。
// 这里按工程根目录的相对路径写，配合 .pro 里的 --include-dir=. 一起生效。
#include "user/inc/appinfo.h"

IDI_ICON1	ICON	DISCARDABLE	"icon\\app_256.ico"

// 应用程序清单：资源类型 24 = RT_MANIFEST，ID 必须为 1 才会被系统当作进程清单加载。
// 清单里声明 requestedExecutionLevel="asInvoker"，可关闭 Windows 的「安装程序检测」，
// 避免系统按文件名关键字猜测可执行文件是安装包、退出时弹出「程序兼容性助手」提示框。
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION APP_VERSION_NUM
	PRODUCTVERSION APP_VERSION_NUM
	FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
	FILEFLAGS VS_FF_DEBUG
#else
	FILEFLAGS 0x0L
#endif
	FILEOS VOS__WINDOWS32
	FILETYPE VFT_APP
	FILESUBTYPE 0x0L
	BEGIN
		BLOCK "StringFileInfo"
		BEGIN
			BLOCK "040904b0"
			BEGIN
				VALUE "CompanyName", APP_AUTHOR_NAME "\0"
				VALUE "FileDescription", APP_NAME "\0"
				VALUE "FileVersion", APP_VERSION "\0"
				VALUE "LegalCopyright", "Copyright (c) " APP_COPYRIGHT_YEAR " " APP_AUTHOR_NAME "\0"
				VALUE "OriginalFilename", APP_ORIGINAL_FILENAME "\0"
				VALUE "ProductName", APP_NAME "\0"
				VALUE "ProductVersion", APP_PRODUCT_VERSION "\0"
			END
		END
		BLOCK "VarFileInfo"
		BEGIN
			VALUE "Translation", 0x0409, 1200
		END
	END
/* End of Version info */
