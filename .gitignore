# ---- qmake 生成物 ----
Makefile
.qmake.stash
object_script.*
*.pro.user
*.pro.user.*

# ---- 构建输出目录（产物与运行依赖不进仓库） ----
/release/

# ---- 编译中间产物 ----
*.o
*.obj
moc_*.cpp
moc_*.h
moc_predefs.h
qrc_*.cpp
ui_*.h

# ---- IDE / AI 工具目录（本机配置与助手产物，整目录不入库） ----
.vscode/
.idea/
.trae/
.codebuddy/
.workbuddy/
.cursor/
.claude/
.qoder/
.qoder-credits/

# ---- 系统/编辑器杂项 ----
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~

# ---- 发布密钥（私钥不得入库）----
# update_keys/ 存放在线更新清单签名用的 RSA 密钥对，私钥泄露等于他人可推送任意更新，整目录排除
update_keys/

# online update release manifests
/publish_info/

# packaged release exes (large binaries, not source)
/pack/*.exe

# bundled Qt runtime for EVB packaging
/pack/app_32/
